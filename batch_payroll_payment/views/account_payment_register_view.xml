<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_payment_register_payroll" model="ir.ui.view">
        <field name="name">account.payment.register.payroll.batch</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <!-- Make amount readonly (calculated from net wage) -->
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- Hide custom_rate field for payroll payments only -->
<!--            <xpath expr="//field[@name='custom_rate']" position="attributes">-->
<!--                <attribute name="invisible">is_payroll_payment</attribute>-->
<!--            </xpath>-->

        </field>
    </record>


</odoo>
