<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Batch Payroll Payment Server Action for Payslips -->
    <record id="action_batch_payroll_payment" model="ir.actions.server">
        <field name="name">Batch Payroll Payment</field>

        <!-- Action appears on payslip list -->
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">form,list</field>

        <field name="state">code</field>

        <field name="code"><![CDATA[
# Call Python method (debug friendly)
action = records.action_open_batch_payment_wizard()
        ]]></field>
    </record>

    <!-- Batch Payroll Payment Server Action for Payslip Runs -->
    <record id="action_batch_payroll_payment_run" model="ir.actions.server">
        <field name="name">Batch Payroll Payment</field>

        <!-- Action appears on payslip run/batch list -->
        <field name="model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_view_types">form,list</field>

        <field name="state">code</field>

        <field name="code"><![CDATA[
# Call Python method (debug friendly)
action = records.action_open_batch_payment_wizard()
        ]]></field>
    </record>

</odoo>
